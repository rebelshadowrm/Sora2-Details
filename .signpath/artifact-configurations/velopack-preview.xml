<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="fileVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="Sora2.Details-win-x64-preview-Setup.exe"
      product-name="Sora 2 Details"
      product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <zip-file path="Sora2.Details-win-x64-preview-Portable.zip">
      <pe-file
        path="current/Sora2.Details.Desktop.exe"
        product-name="Sora 2 Details"
        product-version="${version}"
        file-version="${fileVersion}">
        <authenticode-sign />
      </pe-file>
      <pe-file
        path="current/Sora2.Details.CaptureHost.exe"
        product-name="Sora 2 Details"
        product-version="${version}"
        file-version="${fileVersion}">
        <authenticode-sign />
      </pe-file>
    </zip-file>
    <nupkg-file path="Sora2.Details-${version}-win-x64-preview-full.nupkg">
      <pe-file
        path="lib/app/Sora2.Details.Desktop.exe"
        product-name="Sora 2 Details"
        product-version="${version}"
        file-version="${fileVersion}">
        <authenticode-sign />
      </pe-file>
      <pe-file
        path="lib/app/Sora2.Details.CaptureHost.exe"
        product-name="Sora 2 Details"
        product-version="${version}"
        file-version="${fileVersion}">
        <authenticode-sign />
      </pe-file>
    </nupkg-file>
  </zip-file>
</artifact-configuration>
