<Window x:Class="Sora2.Details.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sora2.Details.Desktop"
        Title="Sora 2 Details"
        Width="340" Height="205" MinWidth="300" MinHeight="170"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowActivated="False"
        Background="#17191D" Foreground="#F7F7F7" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:MeterPreview}">
            <Border Background="#25282D" BorderBrush="#717983" BorderThickness="1" Padding="7" MinWidth="290" MaxWidth="430">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" Margin="2,0,2,5" />
                    <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="15" Height="15" Background="{Binding AvatarBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding InitialBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding IconSource}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" Foreground="White" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ControlTemplate x:Key="MeterBarTemplate" TargetType="ProgressBar">
            <Border x:Name="PART_Track" Background="#2A2D32">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" />
            </Border>
        </ControlTemplate>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D2D2D2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B4047" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MeterRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#A9ADB3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#E8D49A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#555A62" BorderThickness="1" Background="#17191D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="27" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#292B2E" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="27" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ModeButton" Grid.Column="0" Style="{StaticResource ChromeButton}"
                        HorizontalContentAlignment="Left" FontWeight="SemiBold" Click="ModeButton_Click"
                        ToolTip="Choose Player or Enemy Damage Dealt, Damage Taken, Healing, or Deaths" />
                <Border x:Name="HeaderDragArea" Grid.Column="1" Background="Transparent" Cursor="SizeAll"
                        ToolTip="Drag to move · right-click for display settings" />
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="▾"
                        FontSize="15" ToolTip="Recent encounters and full history" Click="HistoryButton_Click" />
                <Button x:Name="CombatLogButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="◷"
                        FontSize="15" ToolTip="Full recorded combat log" Click="TimelineButton_Click" />
                <Button x:Name="UpdateButton" Grid.Column="4" Style="{StaticResource ChromeButton}" Content="↻"
                        ToolTip="Check for updates" Click="UpdateButton_Click" />
                <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Content="─"
                        ToolTip="Hide meter to tray" Click="MinimizeButton_Click" />
                <Button x:Name="CloseButton" Grid.Column="6" Style="{StaticResource ChromeButton}" Content="×"
                        FontSize="17" ToolTip="Hide meter to tray" Click="CloseButton_Click" />
            </Grid>

            <Grid x:Name="EncounterHeader" Grid.Row="1" Background="#202226" Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  ToolTip="Drag to move the meter">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="‹" FontSize="15"
                        Style="{StaticResource ChromeButton}" ToolTip="Back one level (or right-click a row)"
                        Click="BackButton_Click" Visibility="Collapsed" />
                <TextBlock x:Name="EncounterLabel" Grid.Column="1" Margin="6,3,5,0" Foreground="#BFC3C8"
                           TextTrimming="CharacterEllipsis" FontSize="11" />
                <TextBlock x:Name="DataSourceLabel" Grid.Column="2" Margin="4,3,7,0" Text="Waiting for game" FontSize="10"
                           Foreground="#E8BD69" FontWeight="Bold" Cursor="Hand"
                           MouseLeftButtonUp="CaptureStatus_Click" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MeterRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                                    Margin="2,1,2,0" Padding="0"
                                    Style="{StaticResource MeterRowButton}" Click="MeterRow_Click"
                                    PreviewMouseRightButtonDown="MeterRow_RightClick"
                                    ToolTip="{Binding HoverContent}">
                                <Grid ClipToBounds="True">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarPercent}"
                                                 Foreground="{Binding BarBrush}" Template="{StaticResource MeterBarTemplate}" />
                                    <Grid Margin="4,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="17" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="15" Height="15" CornerRadius="2"
                                                Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                            <Grid ClipToBounds="True">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="9"
                                                           Foreground="{Binding InitialBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding IconSource}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding RankLabel}" FontWeight="Bold"
                                                   VerticalAlignment="Center" Foreground="#FAFAFA" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" />
                                        <TextBlock Grid.Column="3" Text="{Binding ValueLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="White" Margin="8,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="FooterDragArea" Grid.Row="3" Background="#202226" Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  ToolTip="Drag to move the meter">
                <TextBlock x:Name="FooterLabel" Margin="6,3,6,0" Foreground="#AEB4BC"
                           FontSize="10" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</Window>
