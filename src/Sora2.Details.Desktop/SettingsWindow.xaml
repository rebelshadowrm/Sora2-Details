<Window x:Class="Sora2.Details.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sora 2 Details Settings"
        Width="390" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#17191D" Foreground="#F7F7F7" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />

            <TextBlock Text="Window behavior" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="When you click X" Foreground="#BFC3C8" Margin="0,0,0,4" />
            <ComboBox x:Name="CloseBehaviorChoice" Height="28" SelectedIndex="0">
                <ComboBoxItem Content="Hide meter to system tray" />
                <ComboBoxItem Content="Close Sora 2 Details" />
            </ComboBox>

            <CheckBox x:Name="AlwaysOnTopChoice" Content="Keep the meter on top" Margin="0,12,0,0" />
            <CheckBox x:Name="LockPositionChoice" Content="Lock meter position" Margin="0,8,0,0" />
            <CheckBox x:Name="ClickThroughChoice" Content="Click-through" Margin="0,8,0,0"
                      ToolTip="Pass clicks to the game. Restore interaction from the system tray." />
            <TextBlock Text="Click-through passes clicks to the game. Use the system tray to restore interaction."
                       Foreground="#9DA3AA" FontSize="11" TextWrapping="Wrap" Margin="22,3,0,0" />

            <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,8" />
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="#BFC3C8" />
                <ComboBox x:Name="OpacityChoice" Grid.Column="1" Height="28" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Text size" VerticalAlignment="Center" Foreground="#BFC3C8" />
                <ComboBox x:Name="FontSizeChoice" Grid.Column="1" Height="28" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="76" Height="30" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" MinWidth="76" Height="30" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
