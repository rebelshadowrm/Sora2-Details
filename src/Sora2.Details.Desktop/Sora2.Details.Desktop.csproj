<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sora2.Details.Core\Sora2.Details.Core.csproj" />
    <Content Include="..\..\samples\command-battles.json" Link="samples\command-battles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\skill-icon-map.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\sora2-details.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>Sora 2 Details</Product>
    <AssemblyTitle>Sora 2 Details</AssemblyTitle>
    <ApplicationIcon>assets\sora2-details.ico</ApplicationIcon>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Sora2.Details.Desktop.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
